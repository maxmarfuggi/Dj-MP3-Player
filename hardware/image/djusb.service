[Unit]
Description=DJ USB wall player
After=systemd-user-sessions.service
RequiresMountsFor=/var/lib/djusb
Conflicts=getty@tty1.service

[Service]
User=admin
Group=admin
SupplementaryGroups=gpio video render input audio
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
Environment=XDG_CONFIG_HOME=/var/lib/djusb
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/usr/bin/cage -s -- /usr/local/bin/djusb-kiosk
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
