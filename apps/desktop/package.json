{
  "name": "dj-mp3-player",
  "version": "0.1.0",
  "private": true,
  "description": "An MP3 Player for DJ USBs",
  "author": "DJ MP3 Player",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxmarfuggi/Dj-MP3-Player.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "typecheck": "tsc -p . && tsc -p src/renderer",
    "test": "vitest run",
    "fixtures": "tsx scripts/fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
